{
  "name": "Cöstar",
  "description": "The helpful browser bot!",
  "version": "1.0",
  "manifest_version": 3,
  "action": {
    "default_popup": "costar-setup.html",
    "default_icon": "costar.png"
  },
  "content_scripts": [
    {
      "js": ["yarn-bound.min.js", "content.js"],
      "css": ["buddy.css"],
      "matches": ["<all_urls>"]
    }
  ],
  "web_accessible_resources": [{
     "resources": ["yarn-bound.min.js", "demo.yarn", "triggers.json", "videos/idle.webm", "videos/twirl.webm", "videos/hectic.webm", "assets/costar-google-logo.png"],
     "matches": ["<all_urls>"]
   }]
}
